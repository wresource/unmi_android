    <!-- About -->
    <string name="about_title">关于项目</string>
    <string name="about_description">Unmi 是一个基于 Kotlin + Jetpack Compose 开发的 Android 本地域名管理系统。采用 Local-first 设计，所有数据默认加密存储在本地设备中，支持云端加密备份。</string>
    <string name="about_security_title">安全机制</string>
    <string name="about_security_desc">• 密码使用 PBKDF2-SHA256 哈希存储\n• 数据加密密钥从密码派生\n• 敏感字段使用 AES-256-GCM 加密\n• 云端仅保存密文数据\n• 支持应用自动锁定</string>
    <string name="about_license">开源协议</string>
    <string name="about_license_value">MIT License</string>
